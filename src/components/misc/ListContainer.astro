---
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	badge?: string;
	icon?: string;
	class?: string;
}

const { title, badge, icon, class: className } = Astro.props;
---

<div class:list={["card-base p-4 flex flex-col", className]}>
	<div
		class="flex items-center gap-2 pb-2 mb-1 border-b border-dashed border-(--line-divider)"
	>
		{icon && <Icon name={icon} class="text-lg text-black/35 dark:text-white/35" />}
		<span
			class="text-sm font-semibold text-black/70 dark:text-white/70 transition"
		>
			{title}
		</span>
		{
			badge && (
				<span class="ml-auto text-[0.7rem] px-1.5 py-0.5 rounded-md bg-(--btn-regular-bg) text-black/45 dark:text-white/45 transition">
					{badge}
				</span>
			)
		}
	</div>

	<slot />
</div>
