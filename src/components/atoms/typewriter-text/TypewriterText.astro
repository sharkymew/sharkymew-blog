---
export interface Props {
	text: string | string[];
	speed?: number;
	deleteSpeed?: number;
	pauseTime?: number;
	class?: string;
}

const {
	text,
	speed = 100,
	deleteSpeed = 50,
	pauseTime = 2000,
	class: className = "",
} = Astro.props;
const textData = Array.isArray(text) ? JSON.stringify(text) : text;
---

<span
	class={`typewriter ${className}`}
	data-text={textData}
	data-speed={speed}
	data-delete-speed={deleteSpeed}
	data-pause-time={pauseTime}></span>

<style>
	.typewriter {
		position: relative;
		min-height: 1.5em; /* 确保即使没有文字也保持最小高度 */
		display: inline-block;
		vertical-align: baseline;
	}

	/* 确保打字机效果不会导致布局抖动 */
	.typewriter:empty::before {
		content: "\00A0"; /* 使用不间断空格保持高度 */
		visibility: hidden;
	}
</style>
